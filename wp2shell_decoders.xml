<!--
  WP2Shell Decoders - CVE-2026-63030 / CVE-2026-60137
  Parses web server access logs for WP2Shell-specific indicators.
  Deploy: /var/ossec/etc/decoders/local_decoder.xml (or a dedicated file)

  The stock Wazuh web-accesslog decoder extracts srcip, url, id, protocol,
  and srcport from CLF/combined-format Apache/Nginx logs. This decoder
  extends detection by:
    - Capturing the full User-Agent header (available in combined log format)
    - Marking requests that carry WP2Shell URI patterns
    - Extracting key query-string parameters (tok, rm, rest_route, c)

  EXTRACTED: patterns are traced directly to wp2shell source functions.
  INFERRED:  edge-case URL-encoding variants (defense-in-depth).
-->

<!-- Parent: identify web access log events with WP2Shell URI patterns -->
<decoder name="wp2shell-web">
  <parent>web-accesslog</parent>
  <use_own_name>true</use_own_name>
  <prematch type="pcre2" offset="after_parent">(?i)(rest_route=/batch/v1|/wp-json/batch/v1|wp2shell|wp-login\.php|wp-admin/update\.php\b.*action=upload-plugin|/wp2shell/v1/)</prematch>
</decoder>

<!-- Extract User-Agent from combined-format logs -->
<!-- Stock web-accesslog stops at the request line; this grabs the UA field -->
<decoder name="wp2shell-web-ua">
  <parent>wp2shell-web</parent>
  <regex type="pcre2" offset="after_parent">\x22 [^\x22]*\x22 \x22(?P&lt;wp2s_ua&gt;[^\x22]*)\x22</regex>
  <order>wp2s_ua</order>
</decoder>

<!-- Extract key query-string tokens: tok, rm -->
<decoder name="wp2shell-web-qs">
  <parent>wp2shell-web</parent>
  <regex type="pcre2" offset="after_parent">[?&amp;](?P&lt;wp2s_qs_key&gt;tok|rm)=(?P&lt;wp2s_qs_val&gt;[a-zA-Z0-9_\-]{8,})</regex>
  <order>wp2s_qs_key, wp2s_qs_val</order>
</decoder>

<!-- Fallback: catch wp2shell UA in any log line (not just web-log) -->
<decoder name="wp2shell-ua-raw">
  <program_name>^web-log|^apache|^nginx</program_name>
  <prematch type="pcre2">(?i)wp2shell-(poc|rce)/</prematch>
</decoder>

<!-- Detect wp2shell REST webshell route in any web request -->
<decoder name="wp2shell-rest-route">
  <parent>wp2shell-web</parent>
  <regex type="pcre2" offset="after_parent">(?i)/wp2shell/v1/(?P&lt;wp2s_route_hex&gt;[a-f0-9]+)</regex>
  <order>wp2s_route_hex</order>
</decoder>

<!-- Detect plugin upload URI with wp2shell archive name -->
<decoder name="wp2shell-plugin-upload">
  <parent>wp2shell-web</parent>
  <regex type="pcre2" offset="after_parent">(?i)filename=\x22wp2shell-(?P&lt;wp2s_ziphex&gt;[a-f0-9]+)\.zip\x22</regex>
  <order>wp2s_ziphex</order>
</decoder>
