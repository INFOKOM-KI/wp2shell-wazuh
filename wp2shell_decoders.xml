<!--
  WP2Shell Decoders - CVE-2026-63030 / CVE-2026-60137
-->
<decoder name="wp2shell-web">
  <type>web-log</type>
  <parent>web-accesslog</parent>
  <use_own_name>true</use_own_name>
  <prematch>(?i)(rest_route=/batch/v1|/wp-json/batch/v1|wp2shell|wp-login\.php|wp-admin/update\.php.*action=upload-plugin|/wp2shell/v1/)</prematch>
</decoder>

<decoder name="wp2shell-web-ua">
  <parent>wp2shell-web</parent>
  <type>web-log</type>
  <regex>"[^"]*"\s+"([^"]*)"$</regex>
  <order>wp2s_ua</order>
</decoder>

<decoder name="wp2shell-web-qs">
  <parent>wp2shell-web</parent>
  <type>web-log</type>
  <regex>[?&amp;](tok|rm)=([a-zA-Z0-9_\-]{8,})</regex>
  <order>wp2s_qs_key, wp2s_qs_val</order>
</decoder>
